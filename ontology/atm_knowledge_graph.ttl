@prefix atmkg: <urn:atm-knowledge-graph:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm-knowledge-graph:ontology> a owl:Ontology ;
    rdfs:label "航管知识图谱本体"@zh-CN ;
    rdfs:comment "基于已核定实际航空基础数据字段的本项目本体。本文件完整定义当前 TBox，不导入外部本体或历史版本，不包含数据实例、清洗执行、Neo4j 写入或三维推理。"@zh-CN .

# Annotation Properties

# Classes
atmkg:AviationBaseObject a owl:Class ;
    rdfs:label "航空基础对象"@zh-CN ;
    rdfs:comment "组织机场、跑道、导航台、报告点、航路、空域、管制区和飞行情报区等基础业务对象。"@zh-CN .

atmkg:RouteSequence a owl:Class ;
    rdfs:label "有序路线结构"@zh-CN ;
    rdfs:comment "表示由顺序节点和相邻航段组成的结构，作为普通航路与班机航线共享节点/航段关系的中性上位类。"@zh-CN .

atmkg:Airport a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "机场"@zh-CN ; rdfs:comment "四字码是当前主要稳定业务标识；airportCode 与 icaoCode 应一致，iataCode 可缺失。"@zh-CN .

atmkg:Runway a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "跑道"@zh-CN ; rdfs:comment "表示物理跑道，长度和宽度属于物理跑道；CODE 包含机场四字码与双向跑道码。"@zh-CN .

atmkg:RunwayDirection a owl:Class ;
    rdfs:label "跑道方向"@zh-CN ; rdfs:comment "表示一个物理跑道的一个运行方向，当前只保存已核定的方向标识，不引入 RunwayEnd、Threshold 或 ReciprocalRunway。"@zh-CN .

atmkg:NavigationAid a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "导航台"@zh-CN ; rdfs:comment "表示 DME、NDB、VOR、TACAN、OTH、VOR/DME 或 VORTAC 类型的导航台，保存代码、名称、英文名、呼号、坐标和 kHz 频率。"@zh-CN .

atmkg:ReportingPoint a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "报告点"@zh-CN ; rdfs:comment "表示源代码为 CRTP、IN-OUT、RPT 或 TRANS 的报告点，保留源代码与中文解释。"@zh-CN .

atmkg:Route a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject, atmkg:RouteSequence ;
    rdfs:label "航路"@zh-CN ; rdfs:comment "表示普通基础航路，routeCode 与 routeName 当前一致，由顺序 RouteNode 和相邻 RouteSegment 组成。"@zh-CN .

atmkg:ScheduledFlightRoute a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject, atmkg:RouteSequence ;
    rdfs:label "班机航线"@zh-CN ;
    rdfs:comment "描述班机运行所采用的顺序路线及相关航行参数，但当前数据中不包含具体执行时间，因此不等同于具体航班或飞行计划实例。后续获得具体航班、飞行计划和时间数据后，可进一步建立与具体运行实例的关系。"@zh-CN .

atmkg:Flight a owl:Class ;
    rdfs:label "航班"@zh-CN ;
    rdfs:comment "表示一个具有稳定业务标识、运行状态、机型、执飞信息和计划/实际时间的具体航班；当前不提前实体化机型、执飞方或状态。"@zh-CN .

atmkg:PlannedFlightRoute a owl:Class ; rdfs:subClassOf atmkg:RouteSequence ;
    rdfs:label "计划航线"@zh-CN ;
    rdfs:comment "表示某一具体航班计划采用的有序路线，可复用 RouteNode 与 RouteSegment 表达顺序结构；不等同于基础 Route 或 ScheduledFlightRoute。"@zh-CN .

atmkg:Airspace a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "空域"@zh-CN ; rdfs:comment "表示具有字符串编码、数字形式业务类型码、上下限和单一顺序 Polygon 几何的空域。"@zh-CN .

atmkg:ControlArea a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "管制区"@zh-CN ; rdfs:comment "表示具有代码、名称、呼号和上下限的管制区；尚未核定的“所属”仍保留 Raw，不生成 managedBy/controlledBy/belongsTo。"@zh-CN .

atmkg:FlightInformationRegion a owl:Class ; rdfs:subClassOf atmkg:AviationBaseObject ;
    rdfs:label "飞行情报区"@zh-CN ; rdfs:comment "表示实际情报区数据对象，完整保留四字码以及可能的 IFR/UR 后缀；后缀精确业务含义尚未核定。"@zh-CN .

atmkg:RouteNode a owl:Class ;
    rdfs:label "路线节点"@zh-CN ; rdfs:comment "表示可复用的路线/航路网络节点；是否跨航路或跨 sourceId 合并由 Mapping 选择的业务主键决定。"@zh-CN .

atmkg:RouteSegment a owl:Class ;
    rdfs:label "航段"@zh-CN ; rdfs:comment "表示 RouteSegment 连接的具体顺序，主要由 fromNode、toNode 和 sequenceNumber 表示。"@zh-CN .

atmkg:AirspaceGeometry a owl:Class ;
    rdfs:label "空域多边形"@zh-CN ; rdfs:comment "表示当前实际空域的单一 Polygon，由至少三个合法、sequence 唯一且完整的 BoundaryPoint 按序组成。"@zh-CN .

atmkg:BoundaryPoint a owl:Class ;
    rdfs:label "边界点"@zh-CN ; rdfs:comment "表示 Polygon 中一个有序坐标点；sequenceNumber 表示 AirspaceGeometry 中的绘制顺序，Polygon 最后点与第一点闭合属于几何解释。"@zh-CN .

# Object Properties
atmkg:hasRunway a owl:ObjectProperty ; rdfs:domain atmkg:Airport ; rdfs:range atmkg:Runway ;
    rdfs:label "具有跑道"@zh-CN ; rdfs:comment "机场索引四字码与 Runway CODE 解析四字码一致时可自动建立；冲突或单一依据时留待人工检查。"@zh-CN .

atmkg:hasDirection a owl:ObjectProperty ; rdfs:domain atmkg:Runway ; rdfs:range atmkg:RunwayDirection ;
    rdfs:label "具有跑道方向"@zh-CN ; rdfs:comment "连接物理跑道与其两个运行方向。"@zh-CN .

atmkg:hasNode a owl:ObjectProperty ; rdfs:domain atmkg:RouteSequence ; rdfs:range atmkg:RouteNode ;
    rdfs:label "具有节点"@zh-CN ; rdfs:comment "连接 Route 或 ScheduledFlightRoute 与其顺序节点。"@zh-CN .

atmkg:hasSegment a owl:ObjectProperty ; rdfs:domain atmkg:RouteSequence ; rdfs:range atmkg:RouteSegment ;
    rdfs:label "具有航段"@zh-CN ; rdfs:comment "连接 Route 或 ScheduledFlightRoute 与由相邻节点生成的航段。"@zh-CN .

atmkg:departsFrom a owl:ObjectProperty ; rdfs:domain atmkg:Flight ; rdfs:range atmkg:Airport ;
    rdfs:label "从机场起飞"@zh-CN ; rdfs:comment "连接具体航班与其出发机场。"@zh-CN .

atmkg:arrivesAt a owl:ObjectProperty ; rdfs:domain atmkg:Flight ; rdfs:range atmkg:Airport ;
    rdfs:label "到达机场"@zh-CN ; rdfs:comment "连接具体航班与其到达机场。"@zh-CN .

atmkg:hasPlannedRoute a owl:ObjectProperty ; rdfs:domain atmkg:Flight ; rdfs:range atmkg:PlannedFlightRoute ;
    rdfs:label "具有计划航线"@zh-CN ; rdfs:comment "连接具体航班与其计划采用的有序路线。"@zh-CN .

atmkg:fromNode a owl:ObjectProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range atmkg:RouteNode ;
    rdfs:label "起始节点"@zh-CN ; rdfs:comment "表示航段在 sequence 顺序中的起始节点。"@zh-CN .
atmkg:toNode a owl:ObjectProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range atmkg:RouteNode ;
    rdfs:label "终止节点"@zh-CN ; rdfs:comment "表示航段在 sequence 顺序中的终止节点。"@zh-CN .

atmkg:refersTo a owl:ObjectProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range atmkg:AviationBaseObject ;
    rdfs:label "引用基础航空对象"@zh-CN ; rdfs:comment "在节点类型码已人工映射后，可按类型和代码/名称建立唯一匹配；机场、报告点/管制移交点、导航台分别指向对应主表。不能仅依据坐标。"@zh-CN .

atmkg:hasGeometry a owl:ObjectProperty ; rdfs:domain atmkg:Airspace ; rdfs:range atmkg:AirspaceGeometry ;
    rdfs:label "具有空域几何"@zh-CN ; rdfs:comment "连接空域业务对象与其单一 Polygon 几何。"@zh-CN .
atmkg:hasBoundaryPoint a owl:ObjectProperty ; rdfs:domain atmkg:AirspaceGeometry ; rdfs:range atmkg:BoundaryPoint ;
    rdfs:label "具有边界点"@zh-CN ; rdfs:comment "连接 Polygon 与其按 sequence 排序的边界点。"@zh-CN .

atmkg:crosses a owl:ObjectProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range atmkg:Airspace ;
    rdfs:label "穿越"@zh-CN ; rdfs:comment "表示经独立空间计算确认的 RouteSegment 穿越 Airspace 事实。"@zh-CN .

# Datatype Properties: shared
atmkg:nameZh a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "中文名称"@zh-CN ; rdfs:comment "保存明确的中文名称。"@zh-CN .
atmkg:nameEn a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "英文名称"@zh-CN ; rdfs:comment "保存明确的英文名称。"@zh-CN .
atmkg:callSign a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "呼号"@zh-CN ; rdfs:comment "保存导航台、报告点、空域或管制区的实际呼号字段。"@zh-CN .
atmkg:countryRegion a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "国家地区"@zh-CN ; rdfs:comment "保留源国家/地区代码或经显式 alias 归一的值。"@zh-CN .
atmkg:latitude a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "纬度"@zh-CN ; rdfs:comment "保存十进制度纬度，源字段可含 N/S 后缀。"@zh-CN .
atmkg:longitude a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "经度"@zh-CN ; rdfs:comment "保存十进制度经度，源字段可含 E/W 后缀。"@zh-CN .
atmkg:sequenceNumber a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "序号"@zh-CN ; rdfs:comment "保存 RouteNode 或 BoundaryPoint 的离散顺序。"@zh-CN .

# Flight
atmkg:flightId a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:string ; rdfs:label "航班唯一标识"@zh-CN ; rdfs:comment "保存源系统中用于稳定识别具体航班的唯一业务标识。"@zh-CN .
atmkg:flightNumber a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:string ; rdfs:label "航班号"@zh-CN ; rdfs:comment "保存具体航班的业务航班号；允许与稳定 flightId 不同。"@zh-CN .
atmkg:aircraftType a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:string ; rdfs:label "机型"@zh-CN ; rdfs:comment "保存当前航班记录中的机型字段；后续确有独立知识对象需求时可通过本体和映射正常实体化。"@zh-CN .
atmkg:operator a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:string ; rdfs:label "执飞方"@zh-CN ; rdfs:comment "保存当前源数据中的执飞人或执飞单位文本；后续需要实体化时通过修改本体和字段映射完成。"@zh-CN .
atmkg:flightStatus a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:string ; rdfs:label "航班状态"@zh-CN ; rdfs:comment "保存源系统提供的航班状态，如计划、取消、执行、完成等；本轮不建立独立状态类或状态机。"@zh-CN .
atmkg:plannedDepartureTime a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:dateTime ; rdfs:label "计划起飞时间"@zh-CN ; rdfs:comment "保存计划起飞时间。"@zh-CN .
atmkg:plannedArrivalTime a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:dateTime ; rdfs:label "计划到达时间"@zh-CN ; rdfs:comment "保存计划到达时间。"@zh-CN .
atmkg:actualDepartureTime a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:dateTime ; rdfs:label "实际起飞时间"@zh-CN ; rdfs:comment "保存实际起飞时间；未执行或尚未产生时允许缺失。"@zh-CN .
atmkg:actualArrivalTime a owl:DatatypeProperty ; rdfs:domain atmkg:Flight ; rdfs:range xsd:dateTime ; rdfs:label "实际到达时间"@zh-CN ; rdfs:comment "保存实际到达时间；未完成或尚未产生时允许缺失。"@zh-CN .

# Airport
atmkg:airportCode a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:string ; rdfs:label "机场代码"@zh-CN ; rdfs:comment "当前与 ICAO 四字码一致，是主要稳定业务标识。"@zh-CN .
atmkg:icaoCode a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:string ; rdfs:label "ICAO 四字码"@zh-CN ; rdfs:comment "机场四字码，当前应与 airportCode 一致。"@zh-CN .
atmkg:iataCode a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:string ; rdfs:label "IATA 三字码"@zh-CN ; rdfs:comment "机场三字码，当前允许缺失。"@zh-CN .
atmkg:airportType a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:string ; rdfs:label "机场类型"@zh-CN ; rdfs:comment "当前实际值仅为民用和军民两用；新值留待人工 alias。"@zh-CN .
atmkg:airportGrade a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:string ; rdfs:label "机场等级"@zh-CN ; rdfs:comment "保存实际民航标准机场等级。"@zh-CN .
atmkg:elevation a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:decimal ; rdfs:label "机场标高（m）"@zh-CN ; rdfs:comment "当前实际源数据单位为 m，按实际值保存，不转 ft、不取整。"@zh-CN .
atmkg:transitionAltitude a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:decimal ; rdfs:label "过渡高度（m）"@zh-CN ; rdfs:comment "当前实际源数据单位为 m，不转换为 ft 或 FL。"@zh-CN .
atmkg:transitionLevel a owl:DatatypeProperty ; rdfs:domain atmkg:Airport ; rdfs:range xsd:decimal ; rdfs:label "过渡高度层（m）"@zh-CN ; rdfs:comment "当前实际数据中该字段单位也为 m，不根据名称自动转为 FL。"@zh-CN .
atmkg:magneticVariation a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "磁差"@zh-CN ; rdfs:comment "保存实际民航数据中的磁差幅度和 E/W 方向。"@zh-CN .

# Runway and direction
atmkg:runwayCode a owl:DatatypeProperty ; rdfs:domain atmkg:Runway ; rdfs:range xsd:string ; rdfs:label "跑道 CODE"@zh-CN ; rdfs:comment "物理跑道代码，由机场四字码和双向跑道码组成。"@zh-CN .
atmkg:length a owl:DatatypeProperty ; rdfs:domain atmkg:Runway ; rdfs:range xsd:decimal ; rdfs:label "跑道长度"@zh-CN ; rdfs:comment "保存物理跑道长度。"@zh-CN .
atmkg:width a owl:DatatypeProperty ; rdfs:domain atmkg:Runway ; rdfs:range xsd:decimal ; rdfs:label "跑道宽度"@zh-CN ; rdfs:comment "保存物理跑道宽度。"@zh-CN .
atmkg:directionIdentifier a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道方向标识"@zh-CN ; rdfs:comment "区分物理跑道的两个运行方向。"@zh-CN .
atmkg:entryLatitude a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道入口纬度"@zh-CN ; rdfs:comment "保存具体运行方向的入口纬度。"@zh-CN .
atmkg:entryLongitude a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道入口经度"@zh-CN ; rdfs:comment "保存具体运行方向的入口经度。"@zh-CN .
atmkg:entryElevation a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道入口高程"@zh-CN ; rdfs:comment "保存具体运行方向的入口高程。"@zh-CN .
atmkg:exitLatitude a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道出口纬度"@zh-CN ; rdfs:comment "保存具体运行方向的出口纬度。"@zh-CN .
atmkg:exitLongitude a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道出口经度"@zh-CN ; rdfs:comment "保存具体运行方向的出口经度。"@zh-CN .
atmkg:exitElevation a owl:DatatypeProperty ; rdfs:domain atmkg:RunwayDirection ; rdfs:range xsd:string ; rdfs:label "跑道出口高程"@zh-CN ; rdfs:comment "保存具体运行方向的出口高程。"@zh-CN .

# NavigationAid and ReportingPoint
atmkg:navigationAidCode a owl:DatatypeProperty ; rdfs:domain atmkg:NavigationAid ; rdfs:range xsd:string ; rdfs:label "导航台代码"@zh-CN ; rdfs:comment "保存导航台业务代码，当前 code 与 name 基本一致。"@zh-CN .
atmkg:navigationAidType a owl:DatatypeProperty ; rdfs:domain atmkg:NavigationAid ; rdfs:range xsd:string ; rdfs:label "导航台类型"@zh-CN ; rdfs:comment "实际值域为 DME、NDB、VOR、TACAN、OH、VOR/DME、VORTAC。"@zh-CN .
atmkg:frequencyKHz a owl:DatatypeProperty ; rdfs:domain atmkg:NavigationAid ; rdfs:range xsd:decimal ; rdfs:label "导航台频率（kHz）"@zh-CN ; rdfs:comment "当前实际源数据中的导航台频率单位为 kHz。"@zh-CN .
atmkg:isTerminalAreaPointRaw a owl:DatatypeProperty ; rdfs:domain atmkg:NavigationAid ; rdfs:range xsd:boolean ; rdfs:label "是否终端区点 Raw"@zh-CN ; rdfs:comment "保留未提升为稳定业务语义的源布尔值。"@zh-CN .
atmkg:isEnroutePointRaw a owl:DatatypeProperty ; rdfs:domain atmkg:NavigationAid ; rdfs:range xsd:boolean ; rdfs:label "是否航线上点 Raw"@zh-CN ; rdfs:comment "保留未提升为稳定业务语义的源布尔值。"@zh-CN .

atmkg:reportingPointCode a owl:DatatypeProperty ; rdfs:domain atmkg:ReportingPoint ; rdfs:range xsd:string ; rdfs:label "报告点代码"@zh-CN ; rdfs:comment "当前 code、name 和 callSign 基本一致，仍分字段保留。"@zh-CN .
atmkg:reportingPointType a owl:DatatypeProperty ; rdfs:domain atmkg:ReportingPoint ; rdfs:range xsd:string ; rdfs:label "报告点类型代码"@zh-CN ; rdfs:comment "保留 CRTP、IN-OUT、RPT、TRANS 源代码。"@zh-CN .
atmkg:reportingPointTypeName a owl:DatatypeProperty ; rdfs:domain atmkg:ReportingPoint ; rdfs:range xsd:string ; rdfs:label "报告点类型名称"@zh-CN ; rdfs:comment "保存源代码的中文解释：强制报告点、进出国境点、非强制报告点或管制移交点。"@zh-CN .
atmkg:reportingPointName a owl:DatatypeProperty ; rdfs:domain atmkg:ReportingPoint ; rdfs:range xsd:string ; rdfs:label "报告点名称"@zh-CN ; rdfs:comment "保存报告点名称。"@zh-CN .
atmkg:isBorderHandoffPointRaw a owl:DatatypeProperty ; rdfs:domain atmkg:ReportingPoint ; rdfs:range xsd:boolean ; rdfs:label "是否国境交接点 Raw"@zh-CN ; rdfs:comment "保留源布尔标志供追溯。"@zh-CN .
atmkg:reportingPointGradeRaw a owl:DatatypeProperty ; rdfs:domain atmkg:ReportingPoint ; rdfs:range xsd:string ; rdfs:label "报告点等级 Raw"@zh-CN ; rdfs:comment "保留尚未核定精确体系的报告点等级。"@zh-CN .

# Route and ScheduledFlightRoute shared fields
atmkg:routeCode a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSequence ; rdfs:range xsd:string ; rdfs:label "路线代码"@zh-CN ; rdfs:comment "保存普通航路或班机航线编号。"@zh-CN .
atmkg:routeName a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSequence ; rdfs:range xsd:string ; rdfs:label "路线名称"@zh-CN ; rdfs:comment "普通航路当前与 routeCode 一致；班机航线保留其独立名称字段。"@zh-CN .
atmkg:routeType a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSequence ; rdfs:range xsd:string ; rdfs:label "路线类型"@zh-CN ; rdfs:comment "保存普通航路民航类型或班机航线类型的源值/显式 alias 值。"@zh-CN .
atmkg:routeUpperLimit a owl:DatatypeProperty ; rdfs:domain atmkg:Route ; rdfs:range xsd:string ; rdfs:label "航路整体上限"@zh-CN ; rdfs:comment "保存航路级上限，与 RouteNode 上限分离。"@zh-CN .
atmkg:routeLowerLimit a owl:DatatypeProperty ; rdfs:domain atmkg:Route ; rdfs:range xsd:string ; rdfs:label "航路整体下限"@zh-CN ; rdfs:comment "保存航路级下限，与 RouteNode 下限分离。"@zh-CN .
atmkg:effectiveFrom a owl:DatatypeProperty ; rdfs:domain atmkg:Route ; rdfs:range xsd:string ; rdfs:label "起始有效期"@zh-CN ; rdfs:comment "保存普通航路起始有效日期原值或保守归一值。"@zh-CN .
atmkg:effectiveTo a owl:DatatypeProperty ; rdfs:domain atmkg:Route ; rdfs:range xsd:string ; rdfs:label "终止有效期"@zh-CN ; rdfs:comment "保存普通航路终止有效日期原值或保守归一值。"@zh-CN .

# RouteNode and RouteSegment
atmkg:nodeCode a owl:DatatypeProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range xsd:string ; rdfs:label "节点代码"@zh-CN ; rdfs:comment "保存完整节点代码；班机航线中的复合字符串不 split。"@zh-CN .
atmkg:nodeName a owl:DatatypeProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range xsd:string ; rdfs:label "节点名称"@zh-CN ; rdfs:comment "保存节点名称；班机航线默认使用该字段匹配基础点。"@zh-CN .
atmkg:nodeTypeCode a owl:DatatypeProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range xsd:string ; rdfs:label "节点类型码"@zh-CN ; rdfs:comment "字符串保存实际数字形式业务码，不当作数学数值。"@zh-CN .
atmkg:nodeTypeName a owl:DatatypeProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range xsd:string ; rdfs:label "节点类型名称"@zh-CN ; rdfs:comment "人工码表核定后可保存机场、地标点、报告点、炮射点、管制移交点、航路点、导航台或障碍物。"@zh-CN .
atmkg:nodeUpperLimit a owl:DatatypeProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range xsd:string ; rdfs:label "节点上限"@zh-CN ; rdfs:comment "忠实保存实际 RouteNode 记录中的 upperLimit。"@zh-CN .
atmkg:nodeLowerLimit a owl:DatatypeProperty ; rdfs:domain atmkg:RouteNode ; rdfs:range xsd:string ; rdfs:label "节点下限"@zh-CN ; rdfs:comment "忠实保存实际 RouteNode 记录中的 lowerLimit。"@zh-CN .
atmkg:magneticCourse a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:decimal ; rdfs:label "磁航向"@zh-CN ; rdfs:comment "仅在人工确认节点附带字段方向后绑定到航段。"@zh-CN .
atmkg:reverseMagneticCourse a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:decimal ; rdfs:label "反向磁航向"@zh-CN ; rdfs:comment "仅在普通航路节点附带字段方向确认后绑定。"@zh-CN .
atmkg:segmentUpperLimit a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:string ; rdfs:label "航段上限"@zh-CN ; rdfs:comment "仅当具体源数据结构确认节点记录携带相邻航段限制时，才由 RouteNode 推导。"@zh-CN .
atmkg:segmentLowerLimit a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:string ; rdfs:label "航段下限"@zh-CN ; rdfs:comment "仅当具体源数据结构确认节点记录携带相邻航段限制时，才由 RouteNode 推导。"@zh-CN .
atmkg:segmentDistance a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:decimal ; rdfs:label "航段距离"@zh-CN ; rdfs:comment "仅在人工确认节点附带字段方向后绑定。"@zh-CN .
atmkg:minimumSafeAltitude a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:decimal ; rdfs:label "最低安全高度"@zh-CN ; rdfs:comment "班机航线非末节点存在而末节点缺失，高度疑似 CURRENT_TO_NEXT；人工核定前不绑定到航段。"@zh-CN .
atmkg:requiredNavigationPerformance a owl:DatatypeProperty ; rdfs:domain atmkg:RouteSegment ; rdfs:range xsd:string ; rdfs:label "所需性能导航"@zh-CN ; rdfs:comment "保存普通航路航段的 RNP 原值。"@zh-CN .

# Airspace
atmkg:airspaceCode a owl:DatatypeProperty ; rdfs:domain atmkg:Airspace ; rdfs:range xsd:string ; rdfs:label "空域代码"@zh-CN ; rdfs:comment "保存字符串 airspaceCode。"@zh-CN .
atmkg:airspaceName a owl:DatatypeProperty ; rdfs:domain atmkg:Airspace ; rdfs:range xsd:string ; rdfs:label "空域名称"@zh-CN ; rdfs:comment "保存空域名称。"@zh-CN .
atmkg:airspaceTypeCode a owl:DatatypeProperty ; rdfs:domain atmkg:Airspace ; rdfs:range xsd:string ; rdfs:label "空域类型码"@zh-CN ; rdfs:comment "字符串保存当前呈数字形式的业务代码，不当作 integer。"@zh-CN .
atmkg:airspaceTypeName a owl:DatatypeProperty ; rdfs:domain atmkg:Airspace ; rdfs:range xsd:string ; rdfs:label "空域类型名称"@zh-CN ; rdfs:comment "保存经实际代码索引人工核定的类型名称，如进近管制区、终端管制区或训练飞行空域。"@zh-CN .
atmkg:airspaceUpperLimit a owl:DatatypeProperty ; rdfs:domain atmkg:Airspace ; rdfs:range xsd:string ; rdfs:label "空域上限"@zh-CN ; rdfs:comment "保存实际空域 upperLimit。"@zh-CN .
atmkg:airspaceLowerLimit a owl:DatatypeProperty ; rdfs:domain atmkg:Airspace ; rdfs:range xsd:string ; rdfs:label "空域下限"@zh-CN ; rdfs:comment "保存实际空域 lowerLimit。"@zh-CN .
atmkg:isEndRaw a owl:DatatypeProperty ; rdfs:domain atmkg:BoundaryPoint ; rdfs:range xsd:boolean ; rdfs:label "是否终点 Raw"@zh-CN ; rdfs:comment "保留原始终点标志；Polygon 组织以 sequence 为准。"@zh-CN .

# ControlArea and FIR
atmkg:controlAreaCode a owl:DatatypeProperty ; rdfs:domain atmkg:ControlArea ; rdfs:range xsd:string ; rdfs:label "管制区代码"@zh-CN ; rdfs:comment "保存管制区 code，当前与 name 一致。"@zh-CN .
atmkg:controlAreaName a owl:DatatypeProperty ; rdfs:domain atmkg:ControlArea ; rdfs:range xsd:string ; rdfs:label "管制区名称"@zh-CN ; rdfs:comment "保存基本以管制单位命名的名称。"@zh-CN .
atmkg:controlAreaUpperLimit a owl:DatatypeProperty ; rdfs:domain atmkg:ControlArea ; rdfs:range xsd:string ; rdfs:label "管制区上限"@zh-CN ; rdfs:comment "保存 ControlArea upperLimit。"@zh-CN .
atmkg:controlAreaLowerLimit a owl:DatatypeProperty ; rdfs:domain atmkg:ControlArea ; rdfs:range xsd:string ; rdfs:label "管制区下限"@zh-CN ; rdfs:comment "保存 ControlArea lowerLimit。"@zh-CN .
atmkg:sourceAffiliationRaw a owl:DatatypeProperty ; rdfs:domain atmkg:ControlArea ; rdfs:range xsd:string ; rdfs:label "源所属 Raw"@zh-CN ; rdfs:comment "保存尚未核定业务关系的“所属”字段。"@zh-CN .
atmkg:sourceCallSignRaw a owl:DatatypeProperty ; rdfs:domain atmkg:ControlArea ; rdfs:range xsd:string ; rdfs:label "源呼号 Raw"@zh-CN ; rdfs:comment "保留历史原始呼号字段以便追溯；当前实际数据使用 callSign。"@zh-CN .

atmkg:flightInformationRegionCode a owl:DatatypeProperty ; rdfs:domain atmkg:FlightInformationRegion ; rdfs:range xsd:string ; rdfs:label "飞行情报区代码"@zh-CN ; rdfs:comment "完整保留 XXXX、XXXXIFR 或 XXXXUR 等源 code，不剪掉后缀。"@zh-CN .
atmkg:firUpperLimit a owl:DatatypeProperty ; rdfs:domain atmkg:FlightInformationRegion ; rdfs:range xsd:string ; rdfs:label "飞行情报区上限"@zh-CN ; rdfs:comment "保存 FIR upperLimit。"@zh-CN .
atmkg:firLowerLimit a owl:DatatypeProperty ; rdfs:domain atmkg:FlightInformationRegion ; rdfs:range xsd:string ; rdfs:label "飞行情报区下限"@zh-CN ; rdfs:comment "保存 FIR lowerLimit。"@zh-CN .
