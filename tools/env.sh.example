#!/bin/sh
# 复制为 tools/env.sh 后按现场环境修改；env.sh 不应提交。
export JAVA_HOME="/opt/atmkg/jdk-17"
# 仅开发工具需要 Maven；正式 runtime.sh 不需要。
export MAVEN_HOME="/opt/atmkg/apache-maven-3.9.11"

export ATMKG_NEO4J_HOME="/opt/atmkg/neo4j-community-5.26.0"
export ATMKG_NEO4J_URI="bolt://127.0.0.1:17687"
export ATMKG_NEO4J_DATABASE="neo4j"
export ATMKG_NEO4J_USERNAME="neo4j"
export ATMKG_NEO4J_PASSWORD="<现场密码>"

export ATMKG_API_HOST="127.0.0.1"
export ATMKG_API_PORT="18080"
