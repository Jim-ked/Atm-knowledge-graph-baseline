@echo off
rem 复制为 tools\env.cmd 后按现场环境修改；env.cmd 已被 .gitignore 忽略。
rem 该文件由 runtime/check/Neo4j/开发工具自动加载，只对当前命令窗口及其子进程有效。

set "JAVA_HOME=D:\tools\jdk-17"
rem 开发期 tools\service.cmd/review.cmd 等仍需要 Maven；正式 runtime 不需要。
set "MAVEN_HOME=D:\tools\apache-maven-3.9.11"

set "ATMKG_NEO4J_HOME=D:\tools\neo4j-community-5.26.0"
set "ATMKG_NEO4J_URI=bolt://127.0.0.1:17687"
set "ATMKG_NEO4J_DATABASE=neo4j"
set "ATMKG_NEO4J_USERNAME=neo4j"
set "ATMKG_NEO4J_PASSWORD=<现场密码>"

set "ATMKG_API_HOST=127.0.0.1"
set "ATMKG_API_PORT=18080"
